# paperless-gpt settings (paperless-gpt v0.31.0). Keep this file chmod 600.
# Only used by `docker compose --profile gpt up -d`.

# --- Paperless-ngx (home k3s, ns paperless, v2.20.15) ---
PAPERLESS_BASE_URL=https://paperless.example.lan
PAPERLESS_PUBLIC_URL=https://paperless.example.lan
# Paste a token here: Paperless UI -> profile (top right) -> "My Profile" -> API Auth Token.
PAPERLESS_API_TOKEN=

# --- Tags: ONLY documents you tag by hand are touched ---
# Add this tag to a document in Paperless to OCR it with Docling (the result replaces the doc's text content).
AUTO_OCR_TAG=ocr-docling
# Added after a successful OCR run (auto-created in Paperless at first start).
PDF_OCR_TAGGING=true
PDF_OCR_COMPLETE_TAG=ocr-docling-done
# Added if OCR fails OCR_MAX_RETRIES times (auto-created in Paperless at first start).
FAIL_TAG=ocr-docling-failed
OCR_MAX_RETRIES=3
# Manual review queue in the paperless-gpt UI (suggestions are only generated when you click).
MANUAL_TAG=paperless-gpt
# LLM auto-tagging is not used: unique tag nobody sets, and no completion tag is created.
AUTO_TAG=pgpt-llm-autotag-unused
AUTO_TAG_COMPLETE=
AUTO_GENERATE_TITLE=false
AUTO_GENERATE_TAGS=false
AUTO_GENERATE_CORRESPONDENTS=false
AUTO_GENERATE_DOCUMENT_TYPE=false
AUTO_GENERATE_CREATED_DATE=false
CREATE_NEW_TAGS=false

# --- OCR via docling-serve (CPU, standard pipeline) ---
OCR_PROVIDER=docling
DOCLING_URL=http://docling:5001
DOCLING_OCR_PIPELINE=standard
DOCLING_OCR_ENGINE=easyocr
DOCLING_OUTPUT_FORMAT=md
DOCLING_IMAGE_EXPORT_MODE=placeholder
# pdf mode: 12 s and a correct table on the test page; image mode took 32 s and dropped a table cell
OCR_PROCESS_MODE=image
OCR_LIMIT_PAGES=5
# Never write PDFs back to Paperless or delete anything.
PDF_UPLOAD=false
PDF_REPLACE=false
CREATE_LOCAL_PDF=false
CREATE_LOCAL_HOCR=false

# --- LLM: required by paperless-gpt at startup but NOT used for Docling OCR ---
# Placeholder endpoint on purpose (nothing listens there). Point it at a real
# OpenAI-compatible LLM only if you want title/tag suggestions later.
LLM_PROVIDER=openai
LLM_MODEL=unused
OPENAI_API_KEY=
OPENAI_BASE_URL=http://127.0.0.1:9/v1
LLM_LANGUAGE=German

LOG_LEVEL=info
