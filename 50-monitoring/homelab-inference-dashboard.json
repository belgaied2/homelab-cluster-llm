{
 "uid": "homelab-inference",
 "title": "Homelab Inference",
 "timezone": "browser",
 "refresh": "5s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "schemaVersion": 39,
 "tags": [
  "kcd",
  "gpu",
  "hami"
 ],
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "GTX 1080 Ti: one card, three AI workloads (HAMi slices)",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 2,
   "title": "GPU memory used per workload (stacked) vs physical card",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "max by (pod) (hami_vgpu_memory_used_bytes{namespace=\"hami-demo\"})",
     "legendFormat": "{{pod}}"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "B",
     "expr": "max(DCGM_FI_DEV_FB_USED{modelName=~\".*1080 Ti.*\"}) * 1024 * 1024",
     "legendFormat": "physical card used (dcgm)"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "C",
     "expr": "max(hami_gpu_memory_limit_bytes{node=\"<hami-gpu-node>\"})",
     "legendFormat": "card total"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "custom": {
      "stacking": {
       "mode": "normal",
       "group": "A"
      },
      "fillOpacity": 40,
      "lineWidth": 1
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": "physical.*|card total"
      },
      "properties": [
       {
        "id": "custom.stacking",
        "value": {
         "mode": "none"
        }
       },
       {
        "id": "custom.fillOpacity",
        "value": 0
       },
       {
        "id": "custom.lineStyle",
        "value": {
         "fill": "dash",
         "dash": [
          10,
          10
         ]
        }
       },
       {
        "id": "custom.lineWidth",
        "value": 2
       }
      ]
     }
    ]
   },
   "options": {},
   "description": "hami_vgpu_memory_used_bytes per pod, stacked, against what the physical card reports."
  },
  {
   "id": 3,
   "title": "Slice usage: used / HAMi limit per pod",
   "type": "bargauge",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 1,
    "w": 6,
    "h": 9
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "max by (pod) (hami_vgpu_memory_used_bytes{namespace=\"hami-demo\"}) / max by (pod) (hami_vgpu_memory_limit_bytes{namespace=\"hami-demo\"})",
     "legendFormat": "{{pod}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "min": 0,
     "max": 1,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.8
       },
       {
        "color": "red",
        "value": 0.95
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "displayMode": "gradient",
    "showUnfilled": true
   }
  },
  {
   "id": 4,
   "title": "HAMi slice limits",
   "type": "bargauge",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 18,
    "y": 1,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "max by (pod) (hami_vgpu_memory_limit_bytes{namespace=\"hami-demo\"})",
     "legendFormat": "{{pod}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "displayMode": "basic"
   }
  },
  {
   "id": 5,
   "title": "Allocated by HAMi vs card",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 18,
    "y": 5,
    "w": 6,
    "h": 5
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "max(hami_gpu_memory_allocated_bytes{node=\"<hami-gpu-node>\"}) / max(hami_gpu_memory_limit_bytes{node=\"<hami-gpu-node>\"})",
     "legendFormat": "allocated"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "B",
     "expr": "count(max by (pod) (hami_vgpu_memory_limit_bytes{namespace=\"hami-demo\"}))",
     "legendFormat": "pods on 1 GPU"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "allocated"
      },
      "properties": [
       {
        "id": "unit",
        "value": "percentunit"
       }
      ]
     }
    ]
   },
   "options": {
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value_and_name"
   }
  },
  {
   "id": 6,
   "title": "1080 Ti utilisation (HAMi) & power (dcgm)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 10,
    "w": 12,
    "h": 7
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "max(hami_host_gpu_utilization_ratio{device_type=~\".*1080 Ti.*\"})",
     "legendFormat": "GPU util % (HAMi)"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "B",
     "expr": "max(DCGM_FI_DEV_POWER_USAGE{modelName=~\".*1080 Ti.*\"})",
     "legendFormat": "power W"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {},
   "description": "dcgm-exporter samples every ~30 s and misses short bursts; HAMi's host utilisation is used for util."
  },
  {
   "id": 7,
   "title": "Per-pod GPU utilisation (HAMi)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 10,
    "w": 12,
    "h": 7
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "max by (pod) (hami_container_device_utilization_ratio{namespace=\"hami-demo\"})",
     "legendFormat": "{{pod}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 8,
   "type": "row",
   "title": "Tokens per second (llama.cpp)",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 17,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 9,
   "title": "Generated tokens/s per model",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 18,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "sum by (app, node) (rate(llamacpp:tokens_predicted_total[30s]))",
     "legendFormat": "{{app}} @ {{node}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "fillOpacity": 15,
      "lineWidth": 2
     }
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 10,
   "title": "Peak generation tokens/s (last 5 min)",
   "type": "bargauge",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 18,
    "w": 6,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "max by (app) (max_over_time(llamacpp:predicted_tokens_seconds[5m]))",
     "legendFormat": "{{app}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "displayMode": "gradient"
   }
  },
  {
   "id": 11,
   "title": "Requests in flight",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 18,
    "y": 18,
    "w": 6,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "sum by (app) (llamacpp:requests_processing)",
     "legendFormat": "{{app}} processing"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "B",
     "expr": "sum by (app) (llamacpp:requests_deferred)",
     "legendFormat": "{{app}} deferred"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 12,
   "type": "row",
   "title": "RX 6900 XT: Vulkan, no HAMi / Kaito / vLLM",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 26,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 13,
   "title": "6900 XT VRAM",
   "type": "gauge",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 27,
    "w": 6,
    "h": 7
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "max(node_drm_memory_vram_used_bytes{instance=~\".*<amd-node-ip>.*\"}) / max(node_drm_memory_vram_size_bytes{instance=~\".*<amd-node-ip>.*\"})",
     "legendFormat": "VRAM"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "min": 0,
     "max": 1
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 14,
   "title": "6900 XT busy % and VRAM",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 6,
    "y": 27,
    "w": 18,
    "h": 7
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "max(node_drm_gpu_busy_percent{instance=~\".*<amd-node-ip>.*\"})",
     "legendFormat": "busy %"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "B",
     "expr": "max(node_drm_memory_vram_used_bytes{instance=~\".*<amd-node-ip>.*\"}) / 1024^3",
     "legendFormat": "VRAM used GiB"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 15,
   "type": "row",
   "title": "Kaito + llm-d (vLLM): needs an NVIDIA GPU with CC >= 7.0",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 34,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 16,
   "title": "Prefix cache hit rate per replica",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 35,
    "w": 6,
    "h": 7
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "sum by (pod) (rate(vllm:prefix_cache_hits_total[1m])) / sum by (pod) (rate(vllm:prefix_cache_queries_total[1m]))",
     "legendFormat": "{{pod}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 17,
   "title": "Requests running per replica",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 6,
    "y": 35,
    "w": 6,
    "h": 7
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "sum by (pod) (vllm:num_requests_running)",
