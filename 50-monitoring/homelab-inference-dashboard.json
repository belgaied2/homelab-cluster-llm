    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 19,
   "title": "TTFT p50",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 18,
    "y": 35,
    "w": 6,
